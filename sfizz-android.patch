diff --git a/src/sfizz_resources.h b/src/sfizz_resources.h
new file mode 100644
index 00000000..ae4d70ce
--- /dev/null
+++ b/src/sfizz_resources.h
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: BSD-2-Clause
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Immutable encoded resources. Names are canonical, case-sensitive pack-relative
+ * UTF-8 paths. The caller transfers one ownership reference to load_resources,
+ * including on failure. release must remain callable until all readers finish.
+ * No callback is made from the audio thread. ABI version 1. */
+typedef struct sfizz_resource_t {
+    const char* name;
+    const void* data;
+    size_t size;
+} sfizz_resource_t;
+typedef struct sfizz_resource_pack_t {
+    uint32_t version;
+    const char* entry;
+    const sfizz_resource_t* resources;
+    size_t count;
+    void* owner;
+    void (*release)(void*);
+    /* Version 2: resources is a names-only index; open supplies bytes on demand.
+     * Called only from control/loading threads. Bytes remain valid until release.
+     * Version 1 callers need not supply this appended field. */
+    int (*open)(void* owner, const char* name, const void** data, size_t* size);
+} sfizz_resource_pack_t;
+#define SFIZZ_RESOURCE_FEATURE "urn:org.androidaudioplugin:sfz-resources:1"
+#define SFIZZ_RESOURCE_INTERFACE "urn:org.androidaudioplugin:sfz-selection:1"
+#define SFIZZ_RESOURCE_STATE "urn:org.androidaudioplugin:sfz-selection:1#identity"
+/* Host feature. open runs on a control/worker thread, returns an owned snapshot. */
+typedef struct sfizz_resource_host_t {
+    void* handle;
+    int (*open)(void*, const char* identity, sfizz_resource_pack_t*);
+} sfizz_resource_host_t;
+/* LV2 local interface. load is OFF/serialized with state operations by caller. */
+typedef struct sfizz_resource_interface_t {
+    void (*set_host)(void* instance, const sfizz_resource_host_t* host);
+    int (*load)(void* instance, const char* identity);
+    int (*region_count)(void* instance);
+} sfizz_resource_interface_t;
+
+/* The plugin resolves a process-wide fallback host by dlsym()ing this symbol at
+ * instantiate(); the companion resource library exports it. The pointee must
+ * outlive every plugin instance. */
+extern const sfizz_resource_host_t* aap_sfizz_default_resource_host(void);
+#ifdef __cplusplus
+}
+#endif
