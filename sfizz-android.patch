+AudioReaderPtr FilePool::openAudio(const fs::path& path, bool reverse, std::error_code* ec) const {
+    if (!resources) return createAudioReader(path, reverse, ec);
+    const auto* r = resources->find(path.generic_string());
+    if (!r) {
+        if (ec) *ec = std::make_error_code(std::errc::no_such_file_or_directory);
+        return {};
+    }
+    auto reader = createAudioReaderFromMemory(r->data, r->size, reverse, ec);
+    if (!reader) return {};
+    return AudioReaderPtr(new ResourceAudioReader(resources, std::move(reader)));
+}
