+bool Synth::loadResources(std::shared_ptr<const ResourceSet> resources)
+{
+    Impl& impl = *impl_;
+    auto& pool = impl.resources_.getFilePool();
+    pool.waitForBackgroundLoading();
+    impl.lastPath_.clear(); // every immutable session is a new cache generation
+    impl.prepareSfzLoad(fs::path("/") / resources->entry);
+    pool.resources = resources;
+    impl.parser_.resources = std::move(resources);
+    impl.parser_.parseFile(fs::path("/") / impl.parser_.resources->entry);
+    if (impl.parser_.getErrorCount() || impl.layers_.empty()) return false;
+    impl.finalizeSfzLoad();
+    return !impl.layers_.empty();
+}
