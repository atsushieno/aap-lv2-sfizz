+// SPDX-License-Identifier: BSD-2-Clause
+#include "catch2/catch.hpp"
+#include "sfizz/Synth.h"
+#include "sfizz/Region.h"
+#include "sfizz/AudioBuffer.h"
+#include <fstream>
+#include <map>
+using namespace sfz;
+namespace {
+struct TestPack {
+    std::map<std::string, std::vector<char>> files;
+    std::vector<sfizz_resource_t> entries;
+    int* released;
+    ~TestPack() { if (released) ++*released; }
+};
+std::shared_ptr<ResourceSet> pack(const std::string& text, int* released = nullptr) {
+    auto* p = new TestPack;
+    p->released = released;
+    p->files["instruments/main.sfz"] = std::vector<char>(text.begin(), text.end());
+    std::string include = "<control> default_path=../samples/\n<region> sample=sine.wav pitch_keycenter=69\n";
+    p->files["instruments/parts/region.sfz"] = std::vector<char>(include.begin(), include.end());
+    std::ifstream wav("../../sample-sfz-provider/src/main/assets/pack/samples/Sine.wav", std::ios::binary);
+    REQUIRE(wav.is_open());
+    p->files["samples/Sine.wav"] = std::vector<char>(std::istreambuf_iterator<char>(wav), {});
+    for (const auto& f : p->files) p->entries.push_back({f.first.c_str(), f.second.data(), f.second.size()});
+    sfizz_resource_pack_t data {1, "instruments/main.sfz", p->entries.data(), p->entries.size(), p,
+        [](void* owner) { delete static_cast<TestPack*>(owner); }};
+    return std::make_shared<ResourceSet>(data);
+}
+}
+TEST_CASE("Resource includes, case correction, parent paths, playback and lifetime", "[resources]") {
+    int released = 0;
+    {
+        Synth synth;
+        synth.setSamplesPerBlock(256);
+        auto resources = pack("#include \"parts/region.sfz\"\n", &released);
+        REQUIRE(synth.loadResources(resources));
+        resources.reset();
+        REQUIRE(released == 0);
+        REQUIRE(synth.getNumRegions() == 1);
+        REQUIRE(synth.getRegionView(0)->sampleId->filename() == "../samples/Sine.wav");
+        synth.noteOn(0, 69, 100);
+        AudioBuffer<float> audio(2, 256);
+        float energy = 0;
+        for (int i = 0; i < 100; ++i) {
+            synth.renderBlock(audio);
+            for (float v : audio.getSpan(0)) energy += v*v;
+        }
+        REQUIRE(energy > 1.0f);
+        // Return to legacy loading; old maps can be freed after jobs complete.
+        REQUIRE(synth.loadSfzString("/virtual/test.sfz", "<region> sample=*sine"));
+        REQUIRE(released == 1);
+    }
+    REQUIRE(released == 1);
+}
+TEST_CASE("Resource failures do not fall back to filesystem", "[resources]") {
+    Synth synth;
+    REQUIRE_FALSE(synth.loadResources(pack("#include \"/etc/passwd\"\n<region> sample=*sine")));
+    REQUIRE_FALSE(synth.loadResources(pack("#include \"../../escape.sfz\"\n<region> sample=*sine")));
+    REQUIRE_FALSE(synth.loadResources(pack("<region> sample=../../escape.wav")));
+    REQUIRE_FALSE(synth.loadResources(pack("<region> sample=missing.wav")));
+    REQUIRE(synth.loadResources(pack("<region> sample=*sine")));
+}
+TEST_CASE("Resource namespaces and normalization", "[resources]") {
+    REQUIRE(ResourceSet::normalize("a/../b/./sample.wav") == "b/sample.wav");
+    REQUIRE_THROWS(ResourceSet::normalize("../../outside.wav"));
+    REQUIRE_THROWS(ResourceSet::normalize("/outside.wav"));
+    Synth one, two;
+    REQUIRE(one.loadResources(pack("<region> sample=*sine")));
+    REQUIRE(two.loadResources(pack("<region> sample=*sine\n<region> sample=*sine")));
+    REQUIRE(one.getNumRegions() == 1);
+    REQUIRE(two.getNumRegions() == 2);
+}
