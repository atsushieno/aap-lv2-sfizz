@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: BSD-2-Clause
+#pragma once
+#include "../sfizz_resources.h"
+#include <algorithm>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <stdexcept>
+#include <vector>
+namespace sfz {
+// Immutable, so parser and background decoder jobs can share the same snapshot.
+class ResourceSet {
+public:
+    explicit ResourceSet(const sfizz_resource_pack_t& pack)
+        : owner_(pack.owner, pack.release ? pack.release : [](void*) {}) {
+        if ((pack.version != 1 && pack.version != 2) || !pack.entry || !pack.resources || !pack.count || pack.count > 65536)
+            throw std::invalid_argument("Invalid resource pack");
+        if (pack.version == 2) {
+            open_ = pack.open;
+            if (!open_) throw std::invalid_argument("Missing resource opener");
+        }
+        entry = normalize(pack.entry);
+        for (size_t i = 0; i < pack.count; ++i) {
+            const auto& r = pack.resources[i];
+            if (!r.name || (!open_ && (!r.data || !r.size))) throw std::invalid_argument("Empty resource");
+            std::string name = normalize(r.name);
+            if (name != r.name || !files_.emplace(name, r).second)
+                throw std::invalid_argument("Noncanonical or duplicate resource name");
+        }
+        if (!find(entry, false, false)) throw std::invalid_argument("Missing entry SFZ");
+    }
+    static std::string normalize(std::string path) {
+        if (path.empty() || path.size() > 4096 || path[0] == '/' || path.find(':') != std::string::npos)
+            throw std::invalid_argument("Invalid resource path");
+        std::replace(path.begin(), path.end(), '\\', '/');
+        std::vector<std::string> parts;
+        size_t start = 0;
+        while (start <= path.size()) {
+            auto end = path.find('/', start);
+            auto part = path.substr(start, end == std::string::npos ? end : end-start);
+            if (part == "..") {
+                if (parts.empty()) throw std::invalid_argument("Resource escapes pack");
+                parts.pop_back();
+            } else if (!part.empty() && part != ".") parts.push_back(part);
+            if (end == std::string::npos) break;
+            start = end+1;
+        }
+        std::string result;
+        for (const auto& p : parts) { if (!result.empty()) result += '/'; result += p; }
+        if (result.empty()) throw std::invalid_argument("Empty resource path");
+        return result;
+    }
+    const sfizz_resource_t* find(std::string path, bool caseFallback = true, bool open = true) const noexcept {
+        try {
+            std::lock_guard<std::mutex> lock(mutex_);
+            // Engine paths live beneath a synthetic root; never touch the filesystem.
+            if (!path.empty() && path[0] == '/') path.erase(0, 1);
+            path = normalize(path);
+            auto it = files_.find(path);
+            auto ensureOpen = [&](sfizz_resource_t* resource) -> const sfizz_resource_t* {
+                if (resource && open && !resource->data) {
+                    const void* data = nullptr;
+                    size_t size = 0;
+                    if (!open_ || !open_(owner_.get(), resource->name, &data, &size) || !data || !size)
+                        return nullptr;
+                    resource->data = data;
+                    resource->size = size;
+                }
+                return resource;
+            };
+            if (it != files_.end()) return ensureOpen(&it->second);
+            if (!caseFallback) return nullptr;
+            auto lower = [](std::string s) { for (char& c : s) if (c >= 'A' && c <= 'Z') c += 'a'-'A'; return s; };
+            const auto folded = lower(path);
+            sfizz_resource_t* found = nullptr;
+            for (auto& item : files_) if (lower(item.first) == folded) {
+                if (found) return nullptr; // ambiguous case, never depend on enumeration order
+                found = &item.second;
+            }
+            return ensureOpen(found);
+        } catch (...) { return nullptr; }
+    }
+    std::string entry;
+private:
+    std::shared_ptr<void> owner_;
+    mutable std::mutex mutex_;
+    mutable std::unordered_map<std::string, sfizz_resource_t> files_;
+    int (*open_)(void*, const char*, const void**, size_t*) = nullptr;
+};
+}
