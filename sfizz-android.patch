+public:
+    ResourceAudioReader(std::shared_ptr<const ResourceSet> o, AudioReaderPtr r)
+        : owner(std::move(o)), reader(std::move(r)) {}
+    AudioReaderType type() const override { return reader->type(); }
+    int format() const override { return reader->format(); }
+    int64_t frames() const override { return reader->frames(); }
+    unsigned channels() const override { return reader->channels(); }
+    unsigned sampleRate() const override { return reader->sampleRate(); }
+    size_t readNextBlock(float* b, size_t n) override { return reader->readNextBlock(b,n); }
+    bool getInstrumentInfo(InstrumentInfo& i) override { return reader->getInstrumentInfo(i); }
